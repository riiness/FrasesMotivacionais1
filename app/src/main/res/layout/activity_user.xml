<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="#5F0E2E"
    >

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Vamos começar?"
        android:layout_centerHorizontal="true"
        android:textSize="30dp"
        android:layout_marginTop="55dp"
        android:textColor="@color/white"
        />

    <EditText
        android:id="@+id/edit_text_nome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:background=""
        android:layout_centerInParent="true"
        android:textColor="@color/white"
        android:text="Qual o seu nome?"
        />

    <Button
        android:id="@+id/button_salvar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Salvar"
        android:backgroundTint="#DEA0A0"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="32dp"
        />

    <View
        android:id="@+id/enfeite"
        android:layout_below="@+id/edit_text_nome"
        android:layout_width="200dp"
        android:layout_height="4dp"
        android:layout_centerHorizontal="true"
        android:background="#260412" />

</RelativeLayout>